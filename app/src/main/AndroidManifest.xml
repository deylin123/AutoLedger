<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- v2.19：用于「后台保活」真实检测与一键申请豁免 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:label="自动记账"
        android:icon="@android:drawable/ic_menu_agenda"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:allowBackup="false">

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          v2.24：singleTop 修「点「全部确认」后要按很多次返回才回到主界面」。
          卡片「改分类」和每条通知都是带 FLAG_ACTIVITY_NEW_TASK 起这个页面的；
          系统按「任务的根 Activity」匹配已有任务，而本 App 任务的根是 MainActivity，
          永远匹配不上 PendingActivity，于是每点一次就往同一个任务里再叠一个实例。
          记了几笔就有几层，全部确认后要一层一层按返回。
          singleTop 让它在栈顶时复用（onNewIntent），配合启动方的 CLEAR_TOP 兜住不在栈顶的情况。
        -->
        <activity
            android:name=".PendingActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <service
            android:name=".BillAccessibilityService"
            android:exported="false"
            android:label="账单抓取"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".PayNotificationListener"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>
</manifest>
