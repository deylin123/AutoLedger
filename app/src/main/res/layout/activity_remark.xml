<?xml version="1.0" encoding="utf-8"?>
<!-- v2.30：备注输入页。结构固定，不用 weight 撑高度（沿用 v2.4 待确认页的教训） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7F5F2"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/tvRemarkHead"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="给这笔账单写备注"
        android:textColor="#333333"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="备注单独保存，不影响自动识别的商户与分类"
        android:textColor="#999999"
        android:textSize="11.5sp" />

    <EditText
        android:id="@+id/etRemark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_card_white"
        android:gravity="top|start"
        android:hint="例如：和同事午餐、出差垫付、给孩子买的书…"
        android:minLines="4"
        android:maxLines="6"
        android:padding="12dp"
        android:textColor="#333333"
        android:textColorHint="#B0B0B0"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnRemarkCancel"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_light"
            android:gravity="center"
            android:text="取消"
            android:textColor="#F2711C"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="12dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/btnRemarkSave"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_orange"
            android:gravity="center"
            android:text="保存备注"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
